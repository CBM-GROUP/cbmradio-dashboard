# Server-runtime only. Dashboard browser requests remain same-origin /api/*.
# Production default: https://apicbmradio.cbmgroupco.com
BACKEND_API_URL=https://apicbmradio.cbmgroupco.com

# Build-time hostname allowlist entry for the HTTPS media/CDN domain.
# Supply the hostname only, without scheme or path.
MEDIA_HOSTNAME=apicbmradio.cbmgroupco.com
